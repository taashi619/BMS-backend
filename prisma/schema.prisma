generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================
   ENUMS
========================= */

enum Role {
  STUDENT
  ADMIN
}

enum BookingStatus {
  BOOKED
  KEY_TAKEN
  RETURN_PENDING
  APPROVED_RETURN
  CANCELLED
}

enum ComplaintStatus {
  NEW
  REVIEWED
  RESOLVED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum AuditAction {
  APPROVE_RETURN
  UNDO_CHARGE
  STATUS_CHANGE
}

enum BicycleStatus {
  AVAILABLE
  BOOKED
  UNDER_MAINTENANCE
  IN_USE
  OUT_OF_SERVICE
}


/* =========================
   USER
========================= */

model User {
  id        Int      @id @default(autoincrement())
  firstName String   
  lastName  String   
  email     String   @unique
  password  String
  role      Role
  status    Boolean  @default(true)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student?
  admin     Admin?
  bookings  Booking[]
  complaints Complaint[]
  maintenanceReports Maintenance[]

  @@map("User")
}

/* =========================
   STUDENT
========================= */

model Student {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  indexNo     String  @unique
  faculty     String?
  roomNumber  String?
  totalFines  Decimal @default(0)
  phone       String?
  isResidential      Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Student")
}

/* =========================
   ADMIN
========================= */

model Admin {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  position String?
  phone    String?
  status   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  approvedBookings Booking[]   @relation("BookingApproval")
  auditLogs        AuditLog[]  @relation("AdminAuditLogs")
  resolvedReports  Maintenance[] @relation("MaintenanceResolution")
  complaints       Complaint[] @relation("AdminComplaints")

  @@map("Admin")
}

/* =========================
   BICYCLE
========================= */

model Bicycle {
  id                  Int      @id @default(autoincrement())
  bicycleNumber       String   @unique
  status              BicycleStatus @default(AVAILABLE)
  lastMaintenanceDate DateTime?
  isActive            Boolean  @default(true)

  bookings            Booking[]
  maintenanceReports  Maintenance[]

  @@map("Bicycle")
}

/* =========================
   BOOKING
========================= */

model Booking {
  id               Int           @id @default(autoincrement())
  userId           Int
  bicycleId        Int
  helmetRequired   Boolean       @default(false)
  note             String?
  bookingTime      DateTime      @default(now())
  returnTime       DateTime?
  actualReturnTime DateTime?
  status           BookingStatus @default(BOOKED)
  fineAmount       Decimal       @default(0)
  keyTaken         Boolean       @default(false)
  approvalId       Int?

  user      User     @relation(fields: [userId], references: [id])
  bicycle   Bicycle  @relation(fields: [bicycleId], references: [id])
  approvedBy Admin?  @relation("BookingApproval", fields: [approvalId], references: [id])
  auditLogs AuditLog[]

  @@map("Booking")
}

/* =========================
   MAINTENANCE
========================= */

model Maintenance {
  id           Int               @id @default(autoincrement())
  userId       Int
  bicycleId    Int
  description  String
  status       MaintenanceStatus @default(OPEN)
  reportedDate DateTime          @default(now())
  resolvedBy   Int?
  photoUrl     String?

  user    User    @relation(fields: [userId], references: [id])
  bicycle Bicycle @relation(fields: [bicycleId], references: [id])
  admin   Admin?  @relation("MaintenanceResolution", fields: [resolvedBy], references: [id])

  @@map("Maintenance")
}

/* =========================
   COMPLAINT
========================= */

model Complaint {
  id          Int             @id @default(autoincrement())
  userId      Int
  adminId     Int?
  description String
  status      ComplaintStatus @default(NEW)
  photoUrl    String?
  createdAt   DateTime        @default(now())

  user  User   @relation(fields: [userId], references: [id])
  admin Admin? @relation("AdminComplaints", fields: [adminId], references: [id])

  @@map("Complaint")
}

/* =========================
   AUDIT LOG
========================= */

model AuditLog {
  id         Int         @id @default(autoincrement())
  bookingId  Int
  adminId    Int
  actionType AuditAction
  reason     String?
  timestamp  DateTime    @default(now())
  previousFineAmount Decimal?  
  newFineAmount      Decimal?

  booking Booking @relation(fields: [bookingId], references: [id])
  admin   Admin   @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@map("AuditLog")
}
